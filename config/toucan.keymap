	                , <&macro_tap &kp D &kp C &kp N4 &kp N0>
	                , <&macro_release &kp LALT>
	                ;
	        };
	        uc_thinking: uc_thinking {
	            label = "UNICODE_EMOJI_THINKING";
	            compatible = "zmk,behavior-macro";
	            #binding-cells = <0>;
	            tap-ms = <0>;
	            wait-ms = <0>;
	            bindings
	                = <&macro_press &kp LALT>
	                , <&macro_tap &kp D &kp N8 &kp N3 &kp E>
	                , <&macro_tap &kp D &kp D &kp N1 &kp N4>
	                , <&macro_release &kp LALT>
	                ;
	        };
	        uc_facepalm: uc_facepalm {
	            label = "UNICODE_EMOJI_FACEPALM";
	            compatible = "zmk,behavior-macro";
	            #binding-cells = <0>;
	            tap-ms = <0>;
	            wait-ms = <0>;
	            bindings
	                = <&macro_press &kp LALT>
	                , <&macro_tap &kp D &kp N8 &kp N3 &kp E>
	                , <&macro_tap &kp D &kp D &kp N2 &kp N6>
	                , <&macro_release &kp LALT>
	                ;
	        };
	        uc_hug: uc_hug {
	            label = "UNICODE_EMOJI_HUG";
	            compatible = "zmk,behavior-macro";
	            #binding-cells = <0>;
	            tap-ms = <0>;
	            wait-ms = <0>;
	            bindings
	                = <&macro_press &kp LALT>
	                , <&macro_tap &kp D &kp N8 &kp N3 &kp E>
	                , <&macro_tap &kp D &kp E &kp C &kp N2>
