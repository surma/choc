	        };
	        uc_party: uc_party {
	            label = "UNICODE_EMOJI_PARTY";
	            compatible = "zmk,behavior-macro";
	            #binding-cells = <0>;
	            tap-ms = <0>;
	            wait-ms = <0>;
	            bindings
	                = <&macro_press &kp LALT>
	                , <&macro_tap &kp D &kp N8 &kp N3 &kp C>
	                , <&macro_tap &kp D &kp F &kp N8 &kp N9>
