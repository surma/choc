	        };
	        uc_ellipsis: uc_ellipsis {
	            label = "UNICODE_ELLIPSIS";
	            compatible = "zmk,behavior-macro";
	            #binding-cells = <0>;
	            tap-ms = <0>;
	            wait-ms = <0>;
	            bindings
