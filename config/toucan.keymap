#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>


#define HYPER (LG(LS(LA(LCTRL))))
#define MEH (LG(LA(LCTRL)))

&sk {
	release-after-ms = <1000>;
	quick-release;
};

/ {
		behaviors {
			meh_esc: meh_esc {
			    compatible = "zmk,behavior-hold-tap";
			    #binding-cells = <2>;
			    flavor = "tap-preferred";
			    tapping-term-ms = <200>;
			    quick-tap-ms = <200>;
			    bindings = <&kp>, <&kp>;
			};
			mouse_entry: mouse_entry {
			    compatible = "zmk,behavior-tap-dance";
			    #binding-cells = <0>;
			    tapping-term-ms = <200>;
			    bindings = <&sl 6>, <&to 11>;
			};
			skm: sticky_mods {
			    compatible = "zmk,behavior-sticky-key";
			    #binding-cells = <1>;
			    release-after-ms = <5000>;
			    quick-release;
			    ignore-modifiers;
			    bindings = <&kp>;
			};
		};

		input_processors {
			touch_pointer_layer: touch_pointer_layer {
				compatible = "zmk,input-processor-behaviors";
				#input-processor-cells = <0>;
				codes = <INPUT_BTN_TOUCH>;
				bindings = <&mo 5>;
			};
		};

		macros {
	        uc_dash: uc_dash {
	            label = "UNICODE_DASH";
	            compatible = "zmk,behavior-macro";
	            #binding-cells = <0>;
	            tap-ms = <0>;
	            wait-ms = <0>;
	            bindings
	                = <&macro_press &kp LALT>
	                , <&macro_tap &kp N2 &kp N0 &kp N1 &kp N4>
	                , <&macro_release &kp LALT>
	                ;
	        };
	        uc_apo: uc_apo {
	            label = "UNICODE_APOSTROPHE";
	            compatible = "zmk,behavior-macro";
	            #binding-cells = <0>;
	            tap-ms = <0>;
	            wait-ms = <0>;
	            bindings
	                = <&macro_press &kp LALT>
	                , <&macro_tap &kp N2 &kp N0 &kp N1 &kp N9>
	                , <&macro_release &kp LALT>
	                ;
	        };
	        uc_lquot: uc_lquot {
	            label = "UNICODE_LEFT_QUOTE";
	            compatible = "zmk,behavior-macro";
	            #binding-cells = <0>;
	            tap-ms = <0>;
	            wait-ms = <0>;
	            bindings
	                = <&macro_press &kp LALT>
	                , <&macro_tap &kp N2 &kp N0 &kp N1 &kp C>
	                , <&macro_release &kp LALT>
	                ;
	        };
	        uc_rquot: uc_rquot {
	            label = "UNICODE_RIGHT_QUOTE";
	            compatible = "zmk,behavior-macro";
	            #binding-cells = <0>;
	            tap-ms = <0>;
	            wait-ms = <0>;
	            bindings
	                = <&macro_press &kp LALT>
	                , <&macro_tap &kp N2 &kp N0 &kp N1 &kp D>
	                , <&macro_release &kp LALT>
	                ;
	        };
	        uc_sz: uc_sz {
	            label = "UNICODE_SZ";
	            compatible = "zmk,behavior-macro";
	            #binding-cells = <0>;
	            tap-ms = <0>;
	            wait-ms = <0>;
	            bindings
	                = <&macro_press &kp LALT>
	                , <&macro_tap &kp N0 &kp N0 &kp D &kp F>
	                , <&macro_release &kp LALT>
	                ;
	        };
	        uc_euro: uc_euro {
	            label = "UNICODE_EURO";
	            compatible = "zmk,behavior-macro";
	            #binding-cells = <0>;
	            tap-ms = <0>;
	            wait-ms = <0>;
	            bindings
	                = <&macro_press &kp LALT>
	                , <&macro_tap &kp N2 &kp N0 &kp A &kp C>
	                , <&macro_release &kp LALT>
	                ;
	        };
	        uc_pound: uc_pound {
	            label = "UNICODE_POUND";
	            compatible = "zmk,behavior-macro";
	            #binding-cells = <0>;
	            tap-ms = <0>;
	            wait-ms = <0>;
	            bindings
	                = <&macro_press &kp LALT>
